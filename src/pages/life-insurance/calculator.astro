---
/**
 * ============================================================================
 * FILE: src/pages/life-insurance/calculator.astro
 * PAGE: HLV Calculator Page (/life-insurance/calculator)
 * SITE: Santanu's Space
 * VERSION: 1.2.0
 * ============================================================================
 */

// Same line works in BOTH English and Bengali files!
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HLVCalculator from '@/components/HLVCalculator.astro';

const pageTitle = "Human Life Value (HLV) Calculator | Life Insurance";
const pageDescription = "Calculate your required term life insurance cover using the Human Life Value method.";
---

<BaseLayout title={pageTitle} description={pageDescription} lang="en">
  <Header />

  <main style="background-color: #f8fafd; padding: 2.5rem 1rem; min-height: 80vh;">
    <div style="max-width: 800px; margin: 0 auto;">
      
      <!-- 1. BREADCRUMB / BACK LINK -->
      <nav style="margin-bottom: 1.5rem; font-size: 0.9rem;">
        <a href="/life-insurance/term-life" style="color: #0b3d91; font-weight: 600; text-decoration: none;">
          ← Back to Term Life Guide
        </a>
        <span style="color: #94a3b8; margin: 0 0.5rem;">|</span>
        <a href="/life-insurance" style="color: #64748b; text-decoration: none;">
          Life Insurance Hub
        </a>
      </nav>

      <!-- 2. THE CALCULATOR COMPONENT -->
      <HLVCalculator lang="en" />

      <!-- 3. RELATED GUIDES & NEXT STEPS (Prevents Dead End) -->
      <div style="margin-top: 3rem; padding: 2rem; background: #ffffff; border-radius: 10px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <h3 style="color: #0b3d91; margin-top: 0; font-size: 1.25rem;">
          What to do after calculating your cover?
        </h3>
        <p style="color: #475569; line-height: 1.6;">
          Once you know your ideal sum assured, the next step is choosing the right policy structure and riders.
        </p>

        <ul style="color: #334155; line-height: 1.8; padding-left: 1.2rem; margin-bottom: 1.5rem;">
          <li>
            <a href="/life-insurance/term-life" style="color: #0b3d91; font-weight: 600; text-decoration: underline;">
              Read the Term Life Insurance Guide
            </a> 
            — Learn about claim settlement ratios, critical riders, and tax benefits.
          </li>
          <li>
            <strong>Get Custom Quotes:</strong> Click the button inside the calculator above to request personalized quotes directly.
          </li>
        </ul>

        <div style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 1.25rem; margin-top: 1rem;">
          <a href="/life-insurance" style="display: inline-block; color: #0b3d91; font-weight: bold; text-decoration: none;">
            Explore All Life Insurance Guides →
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>