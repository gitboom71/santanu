---
// Standalone 404 Page with Auto-Redirect
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Page Not Found</title>
    <style>
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        margin: 0;
        background-color: #0f172a;
        color: #f8fafc;
        text-align: center;
        padding: 1rem;
      }
      .card {
        background: #1e293b;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        max-width: 450px;
        width: 100%;
        border: 1px solid #334155;
      }
      h1 {
        font-size: 2.5rem;
        margin-top: 0;
        color: #38bdf8;
      }
      p {
        color: #cbd5e1;
        font-size: 1.1rem;
        line-height: 1.5;
      }
      .timer-text {
        font-size: 0.95rem;
        color: #94a3b8;
        margin-top: 1.5rem;
      }
      a {
        display: inline-block;
        margin-top: 1rem;
        color: #38bdf8;
        text-decoration: none;
        font-weight: bold;
      }
      a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>404</h1>
      <p>
        Oops! The page you are looking for does not exist or has been moved.
      </p>
      <p class="timer-text">
        Redirecting you to the home page in <span id="countdown">5</span> seconds...
      </p>
      <a id="home-link" href="/">← Return Home Immediately</a>
    </div>

    <script>
      // Detect if user came from a Bengali route
      const isBengali = window.location.pathname.startsWith("/bn");
      const targetUrl = isBengali ? "/bn" : "/";

      // Update link dynamically
      const homeLink = document.getElementById("home-link");
      if (homeLink) homeLink.setAttribute("href", targetUrl);

      // Auto-redirect countdown
      let seconds = 5;
      const countdownEl = document.getElementById("countdown");

      const interval = setInterval(() => {
        seconds--;
        if (countdownEl) countdownEl.textContent = seconds.toString();
        if (seconds <= 0) {
          clearInterval(interval);
          window.location.href = targetUrl;
        }
      }, 1000);
    </script>
  </body>
</html>
