---
// ============================================================================
// PROJECTS PAGE (src/pages/projects.astro)
// Purpose: Displays portfolio items grouped across Technology, Insurance, and Learning
// ============================================================================

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Projects | Santanu's Space">
    <Header lang="en" />

    <main class="projects-page">
        <div class="container">
            <!-- PAGE HEADER -->
            <header class="page-header">
                <h1>Featured Initiatives & Projects</h1>
                <p>
                    A collection of technical solutions, financial advisory
                    frameworks, and educational resources.
                </p>
            </header>

            <!-- PROJECTS GRID -->
            <div class="projects-grid">
                <!-- CARD 1: Technology Initiative -->
                <article class="project-card">
                    <span class="category-badge tech">Technology</span>
                    <h2>Modern Web Architectures</h2>
                    <p>
                        Designing high-performance, fast-loading static and
                        hybrid websites using Astro, responsive CSS, and
                        decoupled deployments on Vercel.
                    </p>
                    <div class="tech-stack">
                        <span>Astro</span>
                        <span>JavaScript</span>
                        <span>Vercel</span>
                    </div>
                </article>

                <!-- CARD 2: Insurance Advisory -->
                <article class="project-card">
                    <span class="category-badge insurance">Insurance</span>
                    <h2>Financial Protection Frameworks</h2>
                    <p>
                        Developing structured evaluation guides and coverage
                        planning frameworks to help families assess term life
                        and health insurance options.
                    </p>
                    <div class="tech-stack">
                        <span>Life Insurance</span>
                        <span>Health Insurance</span>
                        <span>Risk Advisory</span>
                    </div>
                </article>

                <!-- CARD 3: Learning & Mentorship -->
                <article class="project-card">
                    <span class="category-badge learning">Learning</span>
                    <h2>Technical & SQL Learning Guides</h2>
                    <p>
                        Authoring practical tutorials and reference materials
                        focusing on database query logic, SQL development, and
                        foundational IT skills.
                    </p>
                    <div class="tech-stack">
                        <span>SQL</span>
                        <span>Database Logic</span>
                        <span>Tutorials</span>
                    </div>
                </article>
            </div>
        </div>
    </main>

    <Footer lang="en" />
</BaseLayout>

<!-- SCOPED STYLES -->
<style>
    .projects-page {
        /* Matches global background variable */
        background-color: var(--background);
        color: var(--text-main);
        padding: 3.5rem 1.5rem;
        min-height: 80vh;
        transition: background-color 0.3s ease;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* --- PAGE HEADER BANNER --- */
    .page-header {
        text-align: center;
        margin-bottom: 3rem;
        padding: 2.5rem 1.5rem;
        background-color: var(--primary); /* Uses your brand primary */
        border-radius: 8px;
    }

    .page-header h1 {
        font-size: 2.2rem;
        color: var(--white) !important;
        margin-bottom: 0.5rem;
        font-weight: 800;
    }

    .page-header p {
        font-size: 1.1rem;
        color: var(--text-light) !important;
        margin: 0;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.75rem;
    }

    /* --- THEME-AWARE PROJECT CARDS --- */
    .project-card {
        /* FIX: Changed to --bg-white and --border-light to fix Dark Mode! */
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px var(--shadow-color);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease,
            box-shadow 0.3s ease,
            transform 0.3s ease;
    }

    .project-card:hover {
        box-shadow: 0 10px 20px -5px var(--shadow-color);
        transform: translateY(-4px);
    }

    .project-card h2 {
        font-size: 1.3rem;
        color: var(--text-heading);
        margin: 0 0 0.75rem 0;
    }

    .project-card p {
        color: var(--text-body);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }

    /* --- CATEGORY BADGES --- */
    .category-badge {
        align-self: flex-start;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 4px;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    /* Note: Hardcoded badge colors are fine here as they are meant to pop */
    .category-badge.tech {
        background: #e0f2fe;
        color: #0369a1;
    }

    .category-badge.insurance {
        background: #fef3c7;
        color: #b45309;
    }

    .category-badge.learning {
        background: #dcfce7;
        color: #15803d;
    }

    /* --- TECH STACK LABELS --- */
    .tech-stack {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tech-stack span {
        /* FIX: Mapped correctly to your global alternate background */
        background: var(--bg-alt);
        color: var(--text-slate);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }
</style>
