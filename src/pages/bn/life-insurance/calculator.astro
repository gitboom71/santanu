---
/**
 * ============================================================================
 * FILE: src/pages/bn/life-insurance/calculator.astro
 * PAGE: Bengali HLV Calculator Page (/bn/life-insurance/calculator)
 * SITE: Santanu's Space
 * VERSION: 1.2.0
 * ============================================================================
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HLVCalculator from '@/components/HLVCalculator.astro';

const pageTitle = "হিউম্যান লাইফ ভ্যালু (HLV) ক্যালকুলেটর | লাইফ ইনস্যুরেন্স";
const pageDescription = "হিউম্যান লাইফ ভ্যালু (HLV) পদ্ধতির সাহায্যে আপনার পরিবারের জন্য সঠিক টার্ম ইনস্যুরেন্স কভারেজ হিসাব করুন।";
---

<BaseLayout title={pageTitle} description={pageDescription} lang="bn">
  <Header />

  <main style="background-color: #f8fafd; padding: 2.5rem 1rem; min-height: 80vh;">
    <div style="max-width: 800px; margin: 0 auto;">
      
      <!-- 1. BREADCRUMB / BACK LINK -->
      <nav style="margin-bottom: 1.5rem; font-size: 0.9rem;">
        <a href="/bn/life-insurance/term-life" style="color: #0b3d91; font-weight: 600; text-decoration: none;">
          ← টার্ম লাইফ গাইড-এ ফিরে যান
        </a>
        <span style="color: #94a3b8; margin: 0 0.5rem;">|</span>
        <a href="/bn/life-insurance" style="color: #64748b; text-decoration: none;">
          লাইফ ইনস্যুরেন্স মূল পাতা
        </a>
      </nav>

      <!-- 2. THE CALCULATOR COMPONENT -->
      <HLVCalculator lang="bn" />

      <!-- 3. RELATED GUIDES & NEXT STEPS -->
      <div style="margin-top: 3rem; padding: 2rem; background: #ffffff; border-radius: 10px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <h3 style="color: #0b3d91; margin-top: 0; font-size: 1.25rem;">
          কভারেজ হিসাব করার পর আপনার করণীয় কী?
        </h3>
        <p style="color: #475569; line-height: 1.6;">
          আপনার প্রয়োজনীয় বিমার সঠিক পরিমাণ জানার পর, পরবর্তী ধাপ হলো সঠিক পলিসি কাঠামো ও রাইডার নির্বাচন করা।
        </p>

        <ul style="color: #334155; line-height: 1.8; padding-left: 1.2rem; margin-bottom: 1.5rem;">
          <li>
            <a href="/bn/life-insurance/term-life" style="color: #0b3d91; font-weight: 600; text-decoration: underline;">
              টার্ম লাইফ ইনস্যুরেন্স গাইড পড়ুন
            </a> 
            — ক্লেম সেটেলমেন্ট রেশিও, গুরুত্বপূর্ণ রাইডার এবং ট্যাক্স সুবিধা সম্পর্কে বিস্তারিত জানুন।
          </li>
          <li>
            <strong>ব্যক্তিগত পরামর্শ পান:</strong> আপনার প্রয়োজন অনুযায়ী সঠিক প্ল্যান বেছে নিতে উপরের ক্যালকুলেটর থেকে সরাসরি আমাদের সাথে যোগাযোগ করুন।
          </li>
        </ul>

        <div style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 1.25rem; margin-top: 1rem;">
          <a href="/bn/life-insurance" style="display: inline-block; color: #0b3d91; font-weight: bold; text-decoration: none;">
            সকল লাইফ ইনস্যুরেন্স গাইড দেখুন →
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>