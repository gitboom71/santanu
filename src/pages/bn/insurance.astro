---
// ============================================================================
// BENGALI INSURANCE PAGE (src/pages/bn/insurance.astro)
// Purpose: Main hub for Life & Health Insurance awareness (Bengali Version)
// ============================================================================

import BaseLayout from "@layouts/BaseLayout.astro";
//import Header from "@components/Header.astro";
import Header from "@components/Header.astro";

import Footer from "@components/Footer.astro";
import InsuranceFAQ from "@components/InsuranceFAQ.astro";
import BackToTop from "@components/BackToTop.astro";

// Page Metadata
const pageTitle = "বীমা শিক্ষা কেন্দ্র | জীবন ও স্বাস্থ্য বীমা সচেতনতা";
const pageDescription =
    "সান্তনু ইনিশিয়েটিভের মাধ্যমে জীবন বীমা, স্বাস্থ্য বীমা, এলআইসি প্ল্যান, রাইডার এবং বীমা সচেতনতা সম্পর্কে জানুন।";

// Clean data structures for repetitive layout loops
const quickNavCategories = [
    {
        title: "জীবন বীমা",
        href: "/bn/life-insurance",
        desc: "জীবন সুরক্ষা, এলআইসি প্ল্যান, রাইডার এবং পরিকল্পনা সম্পর্কে জানুন।",
        class: "card-life",
        btnClass: "btn-life",
        btnText: "জীবন বীমা দেখুন →",
        iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 12a11.02 11.02 0 0 0-22 0zm-11-8v8"></path><path d="M12 12a2 2 0 0 0 4 0"></path><path d="M12 14v6a2 2 0 0 0 2 2"></path></svg>`,
    },
    {
        title: "স্বাস্থ্য বীমা",
        href: "/bn/health-insurance",
        desc: "স্বাস্থ্য কভার, ক্লেম, সুবিধা এবং গুরুত্বপূর্ণ শর্তাবলী সম্পর্কে জানুন।",
        class: "card-health",
        btnClass: "btn-health",
        btnText: "স্বাস্থ্য বীমা দেখুন →",
        iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M12 8v8"></path><path d="M8 12h8"></path></svg>`,
    },
    {
        title: "ক্যালকুলেটর",
        href: "#calculators",
        desc: "সহজ সরঞ্জামের সাহায্যে আপনার সুরক্ষার প্রয়োজনীয়তা অনুমান করুন।",
        class: "card-calc",
        btnClass: "btn-calc",
        btnText: "টুলস ব্যবহার করুন →",
        iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="16"></line><line x1="15" y1="22" x2="15" y2="16"></line><line x1="9" y1="16" x2="15" y2="16"></line><path d="M8 6h8"></path><path d="M8 10h8"></path></svg>`,
    },
    {
        title: "উপাদান (Resources)",
        href: "#resources",
        desc: "গাইড, সাধারণ প্রশ্নাবলী (FAQ) এবং দরকারী বীমা শিক্ষার উপকরণ।",
        class: "card-res",
        btnClass: "btn-res",
        btnText: "উপাদান দেখুন →",
        iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>`,
    },
];

const comparisonRows = [
    {
        feature: "উদ্দেশ্য (Purpose)",
        health: "জীবদ্দশায় চিকিৎসা ব্যয় এবং হাসপাতালে ভর্তির খরচ।",
        life: "পলিসিধারীর মৃত্যুর পর পরিবারের জন্য আর্থিক সুরক্ষা।",
    },
    {
        feature: "প্রধান প্রয়োজন",
        health: "জরুরি চিকিৎসার খরচ থেকে বর্তমান সঞ্চয় রক্ষা করা।",
        life: "ভবিষ্যতের আয় এবং পারিবারিক দায়িত্ব রক্ষা করা।",
    },
    {
        feature: "ক্লেম কখন হয়",
        health: "হাসপাতালে ভর্তি, চিকিৎসা বা নির্দিষ্ট স্বাস্থ্য সমস্যা।",
        life: "পলিসির শর্ত অনুযায়ী বীমাকৃত ব্যক্তির মৃত্যু হলে।",
    },
    {
        feature: "সুবিধার ধরন",
        health: "ক্যাশলেস চিকিৎসা বা খরচ ফেরতের (Reimbursement) সুবিধা।",
        life: "নমিনিকে এককালীন আর্থিক সুবিধা প্রদান।",
    },
    {
        feature: "মেয়াদকাল",
        health: "স্বল্পমেয়াদী (প্রতি বছর নবায়ন করতে হয়)।",
        life: "দীর্ঘমেয়াদী (সাধারণত ১০ থেকে ৩০+ বছর, বা সারাজীবন)।",
    },
];
---

<BaseLayout title={pageTitle} description={pageDescription} lang="bn">
    <Header lang="bn" />

    <main>
        <!-- ========================== INSURANCE HERO ========================== -->
        <section class="hero">
            <div class="container">
                <h2 class="centered-title">বীমা শিক্ষা কেন্দ্র</h2>
                <p class="centered-subtitle">
                    গুরুত্বপূর্ণ আর্থিক সিদ্ধান্ত নেওয়ার আগে বীমা সুরক্ষা
                    সম্পর্কে জানুন।
                </p>
            </div>
        </section>

        <!-- ========================== QUICK NAVIGATION ========================== -->
        <section class="section quick-nav bg-alt-strip">
            <div class="container">
                <h2 class="centered-title">বীমা সম্পর্কে জানুন</h2>
                <p class="section-intro centered-subtitle">
                    একটি বিষয় চয়ন করুন এবং সরাসরি সেই বিভাগে যান।
                </p>

                <div class="cards-wrapper">
                    {
                        quickNavCategories.map((card) => (
                            <div class={`insurance-card ${card.class}`}>
                                <div
                                    class="card-icon"
                                    set:html={card.iconSvg}
                                />
                                <h3>{card.title}</h3>
                                <p>{card.desc}</p>
                                <a
                                    href={card.href}
                                    class={`card-btn ${card.btnClass}`}
                                >
                                    {card.btnText}
                                </a>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- ========================== WHY INSURANCE MATTERS ========================== -->
        <section class="section insurance-group">
            <div class="container">
                <h2 class="centered-title">বীমা কেন গুরুত্বপূর্ণ</h2>
                <p class="section-intro centered-subtitle">
                    বীমা শুধু একটি পলিসি কেনা নয়। এটি আপনার পরিবারের আর্থিক
                    স্থিতিশীলতা, আপনার স্বাস্থ্য, আপনার স্বপ্ন এবং ভবিষ্যতের
                    দায়িত্বগুলি রক্ষা করার একটি উপায়।
                </p>

                <div class="cards">
                    <div class="card">
                        <h3>🛡️ জীবন বীমা</h3>
                        <p>
                            জীবন বীমা আপনার পরিবারের জন্য একটি আর্থিক নিরাপত্তা
                            জাল তৈরি করে। জীবনের অপ্রত্যাশিত পরিস্থিতিতে এটি আয়
                            প্রতিস্থাপন এবং স্থিতিশীলতা প্রদানে সাহায্য করে।
                        </p>
                    </div>
                    <div class="card">
                        <h3>❤️ স্বাস্থ্য বীমা</h3>
                        <p>
                            স্বাস্থ্য বীমা চিকিৎসা জরুরি অবস্থা থেকে আপনার
                            কষ্টার্জিত সঞ্চয়কে রক্ষা করে। একটি ভালো স্বাস্থ্য
                            কভার আপনাকে আর্থিক চাপের পরিবর্তে পুনরুদ্ধারে ফোকাস
                            করতে সাহায্য করে।
                        </p>
                    </div>
                    <div class="card">
                        <h3>📘 বীমা শিক্ষা</h3>
                        <p>
                            কয়েক দশকের আইটি অভিজ্ঞতা এবং বিশ্লেষণাত্মক চিন্তার
                            সাহায্যে, আমার লক্ষ্য হল বীমার ধারণাগুলোকে সহজ করা
                            যাতে মানুষ সঠিক সিদ্ধান্ত নিতে পারে।
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========================== LIFE VS HEALTH GUIDE (BN) ========================== -->
        <section class="section insurance-group bg-alt-strip">
            <div class="container">
                <h2 class="centered-title">
                    জীবন বনাম স্বাস্থ্য বীমা: নির্দেশিকা
                </h2>
                <p class="section-intro centered-subtitle">
                    জীবন বীমা এবং স্বাস্থ্য বীমা ভিন্ন ভিন্ন সমস্যার সমাধান করে।
                    এদের মধ্যে পার্থক্য বুঝতে পারা সঠিক সুরক্ষার দিকে প্রথম
                    পদক্ষেপ।
                </p>

                <div class="custom-table-wrapper">
                    <table class="custom-grid-table">
                        <thead>
                            <tr class="custom-header-row">
                                <th class="col-feature">বৈশিষ্ট্য</th>
                                <th class="col-health">❤️ স্বাস্থ্য বীমা</th>
                                <th class="col-life">🛡️ জীবন বীমা</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                comparisonRows.map((row) => (
                                    <tr class="custom-body-row">
                                        <td>
                                            <strong>{row.feature}</strong>
                                        </td>
                                        <td>{row.health}</td>
                                        <td>{row.life}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <!-- ========================== INSURANCE CHOICE CARDS ========================== -->
    <section class="section insurance-group">
        <div class="container">
            <h2 class="centered-title">আপনার বীমার ক্ষেত্র বেছে নিন</h2>
            <div class="cards">
                <div class="card">
                    <h3>🛡️ জীবন বীমা সম্পর্কে জানুন</h3>
                    <p>
                        টার্ম প্ল্যান, সেভিংস প্ল্যান, হোল লাইফ কনসেপ্ট, রাইডার
                        এবং এলআইসি (LIC) প্ল্যান সম্পর্কে অন্বেষণ করুন।
                    </p>
                    <a href="/bn/life-insurance" class="btn">জীবন বীমা দেখুন</a>
                </div>
                <div class="card">
                    <h3>❤️ স্বাস্থ্য বীমা সম্পর্কে জানুন</h3>
                    <p>
                        স্বাস্থ্য কভার, ফ্যামিলি ফ্লোটার, ক্যাশলেস সুবিধা,
                        ওয়েটিং পিরিয়ড এবং অন্যান্য সুবিধাগুলো সম্পর্কে জানুন।
                    </p>
                    <a href="/bn/health-insurance" class="btn"
                        >স্বাস্থ্য বীমা দেখুন</a
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- ========================== INSURANCE CALCULATORS ========================== -->
    <section class="section bg-alt-strip" id="calculators">
        <div class="container">
            <h2 class="centered-title">বীমা ক্যালকুলেটর</h2>
            <p class="section-intro centered-subtitle">
                আপনার সুরক্ষার প্রয়োজনীয়তা বোঝার জন্য সহজ সরঞ্জাম।
            </p>

            <div class="cards">
                <div class="card">
                    <h3>🧮 লাইফ কভার ক্যালকুলেটর</h3>
                    <p>
                        আপনার পরিবারের ভবিষ্যতের লক্ষ্য রক্ষা করতে আনুমানিক জীবন
                        কভারের পরিমাণ গণনা করুন।
                    </p>
                    <button
                        class="btn"
                        disabled
                        style="opacity: 0.6; cursor: not-allowed;"
                        >শীঘ্রই আসছে</button
                    >
                </div>
                <div class="card">
                    <h3>🏥 হেলথ কভার ক্যালকুলেটর</h3>
                    <p>
                        চিকিৎসার ব্যয় বৃদ্ধি এবং পরিবারের চাহিদা কীভাবে আপনার
                        স্বাস্থ্য বীমার প্রয়োজনীয়তাকে প্রভাবিত করে তা বুঝুন।
                    </p>
                    <button
                        class="btn"
                        disabled
                        style="opacity: 0.6; cursor: not-allowed;"
                        >শীঘ্রই আসছে</button
                    >
                </div>
                <div class="card">
                    <h3>📊 আর্থিক পরিকল্পনার টুলস</h3>
                    <p>
                        ভবিষ্যতের টুলগুলোতে অবসর পরিকল্পনা, শিক্ষার লক্ষ্য এবং
                        প্রিমিয়ামের সামর্থ্য যাচাই অন্তর্ভুক্ত থাকবে।
                    </p>
                    <button
                        class="btn"
                        disabled
                        style="opacity: 0.6; cursor: not-allowed;"
                        >শীঘ্রই আসছে</button
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- ========================== LIC LEARNING CENTRE ========================== -->
    <section class="section insurance-group" id="life-learning">
        <div class="container">
            <h2 class="centered-title">এলআইসি (LIC) লার্নিং সেন্টার</h2>
            <p class="section-intro centered-subtitle">
                জটিল নীতিমালার বদলে সহজ ভাষায় এলআইসি প্ল্যানগুলো বুঝুন।
            </p>

            <div class="cards">
                <div class="card">
                    <h3>এলআইসি প্ল্যান বোঝা</h3>
                    <p>
                        প্রোটেকশন প্ল্যান, সেভিংস প্ল্যান, হোল লাইফ কনসেপ্ট এবং
                        সীমিত প্রিমিয়াম বিকল্পসহ বিভিন্ন এলআইসি প্ল্যান কীভাবে
                        কাজ করে তা জানুন।
                    </p>
                </div>
                <div class="card">
                    <h3>উদাহরণ: জীবন উৎসব</h3>
                    <p>
                        নিশ্চিত আয়ের ধারণা, হোল লাইফ সুরক্ষা, প্রিমিয়াম
                        প্রদানের সময়কাল এবং উপযুক্ততার বিষয়গুলো বুঝুন।
                    </p>
                </div>
                <div class="card">
                    <h3>সঠিক পন্থা নির্বাচন</h3>
                    <p>
                        সঠিক প্ল্যানটি লক্ষ্য, আয়ের স্থিতিশীলতা, পারিবারিক
                        দায়িত্ব এবং আর্থিক অগ্রাধিকারের উপর নির্ভর করে।
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================== HEALTH INSURANCE SIMPLIFIED ========================== -->
    <section class="section insurance-group bg-alt-strip" id="health-learning">
        <div class="container">
            <h2 class="centered-title">সহজে স্বাস্থ্য বীমা</h2>
            <p class="section-intro centered-subtitle">
                গুরুত্বপূর্ণ ধারণাগুলো সহজ ভাষায় ব্যাখ্যা করা হয়েছে।
            </p>

            <div class="cards">
                <div class="card">
                    <h3>ইন্ডিভিজুয়াল বনাম ফ্যামিলি ফ্লোটার</h3>
                    <p>
                        পরিবারের বিভিন্ন পরিস্থিতিতে কোন ধরনের স্বাস্থ্য কভার
                        উপযুক্ত হতে পারে তা বুঝুন।
