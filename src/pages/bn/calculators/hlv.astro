---
// src/pages/bn/calculators/hlv.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HLVCalculator from '@/components/HLVCalculator.astro';
---

<BaseLayout title="হিউম্যান লাইফ ভ্যালু ক্যালকুলেটর" lang="bn">
  <Header lang="bn" />

  <main style="background-color: #f8fafd; padding: 2.5rem 1rem; min-height: 80vh;">
    <div style="max-width: 800px; margin: 0 auto;">
      <nav style="margin-bottom: 1.5rem; font-size: 0.9rem;">
        <a href="/bn/calculators" style="color: #0b3d91; font-weight: 600; text-decoration: none;">
          &larr; ক্যালকুলেটর পেজ-এ ফিরে যান
        </a>
      </nav>

      <HLVCalculator lang="bn" />
    </div>
  </main>

  <Footer lang="bn" />
</BaseLayout>