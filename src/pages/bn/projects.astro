---
// ============================================================================
// BENGALI PROJECTS PAGE (src/pages/bn/projects.astro)
// Purpose: Displays portfolio items grouped across Technology, Insurance, and Learning
// ============================================================================

// Notice the double dots (../../) because we are inside the /bn/ folder!
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<BaseLayout title="প্রকল্প | Santanu's Space" lang="bn">
    <Header lang="bn" />

    <main class="projects-page">
        <div class="container">
            <!-- PAGE HEADER -->
            <header class="page-header">
                <h1>উল্লেখযোগ্য উদ্যোগ ও প্রকল্পসমূহ</h1>
                <p>
                    প্রযুক্তি, অর্থব্যবস্থা ও বিভিন্ন বিষয় নিয়ে সহজ ভাষায়
                    নির্ভরযোগ্য তথ্য, ব্যবহারিক পরামর্শ এবং দরকারি রিসোর্স।।
                </p>
            </header>

            <!-- PROJECTS GRID -->
            <div class="projects-grid">
                <!-- CARD 1: Technology Initiative -->
                <article class="project-card">
                    <span class="category-badge tech">প্রযুক্তি</span>
                    <h2>আধুনিক ওয়েব আর্কিটেকচার</h2>
                    <p>
                        অ্যাস্ট্রো (Astro), রেসপন্সিভ সিএসএস এবং ভার্সেল
                        (Vercel)-এ ডিকাপলড ডেপ্লয়মেন্ট ব্যবহার করে
                        উচ্চ-ক্ষমতাসম্পন্ন, দ্রুত-লোডিং স্ট্যাটিক এবং হাইব্রিড
                        ওয়েবসাইট ডিজাইন করা।
                    </p>
                    <div class="tech-stack">
                        <span>Astro</span>
                        <span>JavaScript</span>
                        <span>Vercel</span>
                    </div>
                </article>

                <!-- CARD 2: Insurance Advisory -->
                <article class="project-card">
                    <span class="category-badge insurance">বীমা</span>
                    <h2>আর্থিক সুরক্ষা কাঠামো</h2>
                    <p>
                        পরিবারগুলোকে টার্ম লাইফ এবং স্বাস্থ্য বীমার বিকল্পগুলো
                        মূল্যায়নে সাহায্য করার জন্য কাঠামোগত মূল্যায়ন
                        নির্দেশিকা এবং কভারেজ পরিকল্পনার ফ্রেমওয়ার্ক তৈরি করা।
                    </p>
                    <div class="tech-stack">
                        <span>জীবন বীমা</span>
                        <span>স্বাস্থ্য বীমা</span>
                        <span>ঝুঁকি পরামর্শ</span>
                    </div>
                </article>

                <!-- CARD 3: Learning & Mentorship -->
                <article class="project-card">
                    <span class="category-badge learning">শিক্ষা</span>
                    <h2>প্রযুক্তিগত এবং SQL লার্নিং গাইড</h2>
                    <p>
                        ডেটাবেস কোয়েরি লজিক, এসকিউএল (SQL) ডেভেলপমেন্ট এবং মৌলিক
                        আইটি দক্ষতার ওপর ভিত্তি করে ব্যবহারিক টিউটোরিয়াল এবং
                        রেফারেন্স উপাদান রচনা করা।
                    </p>
                    <div class="tech-stack">
                        <span>SQL</span>
                        <span>ডেটাবেস লজিক</span>
                        <span>টিউটোরিয়াল</span>
                    </div>
                </article>
            </div>
        </div>
    </main>

    <Footer lang="bn" />
</BaseLayout>

<!-- SCOPED STYLES (Exactly the same as the English version) -->
<style>
    .projects-page {
        /* Matches global background variable */
        background-color: var(--background);
        color: var(--text-main);
        padding: 3.5rem 1.5rem;
        min-height: 80vh;
        transition: background-color 0.3s ease;
    }

    .container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* --- PAGE HEADER BANNER --- */
    .page-header {
        text-align: center;
        margin-bottom: 3rem;
        padding: 2.5rem 1.5rem;
        background-color: var(--primary); /* Uses your brand primary */
        border-radius: 8px;
    }

    .page-header h1 {
        font-size: 2.2rem;
        color: var(--white) !important;
        margin-bottom: 0.5rem;
        font-weight: 800;
    }

    .page-header p {
        font-size: 1.1rem;
        color: var(--text-light) !important;
        margin: 0;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.75rem;
    }

    /* --- THEME-AWARE PROJECT CARDS --- */
    .project-card {
        background: var(--bg-white);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 2rem;
        box-shadow: 0 4px 6px -1px var(--shadow-color);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease,
            box-shadow 0.3s ease,
            transform 0.3s ease;
    }

    .project-card:hover {
        box-shadow: 0 10px 20px -5px var(--shadow-color);
        transform: translateY(-4px);
    }

    .project-card h2 {
        font-size: 1.3rem;
        color: var(--text-heading);
        margin: 0 0 0.75rem 0;
    }

    .project-card p {
        color: var(--text-body);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }

    /* --- CATEGORY BADGES --- */
    .category-badge {
        align-self: flex-start;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 4px;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    /* Note: Hardcoded badge colors are fine here as they are meant to pop */
    .category-badge.tech {
        background: #e0f2fe;
        color: #0369a1;
    }

    .category-badge.insurance {
        background: #fef3c7;
        color: #b45309;
    }

    .category-badge.learning {
        background: #dcfce7;
        color: #15803d;
    }

    /* --- TECH STACK LABELS --- */
    .tech-stack {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tech-stack span {
        background: var(--bg-alt);
        color: var(--text-slate);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }
</style>
