---
// src/pages/calculators/health-cover.astro
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HealthCoverCalculator from "@/components/HealthCoverCalculator.astro";
---

<BaseLayout
  title="Health Cover Estimator - Santanu's Space"
  description="Calculate your recommended health insurance cover amount based on family size and location."
>
  <Header />

  <main
    style="background-color: #f8fafd; padding: 2.5rem 1rem; min-height: 80vh;"
  >
    <div style="max-width: 800px; margin: 0 auto;">
      <!-- 1. BREADCRUMB / BACK LINK -->
      <nav style="margin-bottom: 1.5rem; font-size: 0.9rem;">
        <a
          href="/calculators"
          style="color: #0b3d91; font-weight: 600; text-decoration: none;"
        >
          &larr; Back to Calculators Hub
        </a>
        <span style="color: #94a3b8; margin: 0 0.5rem;">|</span>
        <a href="/insurance" style="color: #64748b; text-decoration: none;">
          Insurance Hub
        </a>
      </nav>

      <!-- 2. THE CALCULATOR COMPONENT -->
      <HealthCoverCalculator lang="en" />

      <!-- 3. RELATED GUIDES & NEXT STEPS -->
      <div
        style="margin-top: 3rem; padding: 2rem; background: #ffffff; border-radius: 10px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04);"
      >
        <h3 style="color: #0b3d91; margin-top: 0; font-size: 1.25rem;">
          What to do after estimating your health cover?
        </h3>
        <p style="color: #475569; line-height: 1.6;">
          Once you know your recommended sum insured, the next step is choosing
          the right policy structure and riders.
        </p>

        <ul
          style="color: #334155; line-height: 1.8; padding-left: 1.2rem; margin-bottom: 1.5rem;"
        >
          <li>
            <a
              href="/insurance"
              style="color: #0b3d91; font-weight: 600; text-decoration: underline;"
            >
              Read Health Insurance Guides
            </a>
            — Learn about claim settlement ratios, restoration benefits, and room
            rent caps.
          </li>
          <li>
            <strong>Get Personalized Advisory:</strong> Reach out to us directly for
            guidance on picking the right floater policy or Super Top-Up plan.
          </li>
        </ul>

        <div
          style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 1.25rem; margin-top: 1rem;"
        >
          <a
            href="/calculators"
            style="display: inline-block; color: #0b3d91; font-weight: bold; text-decoration: none;"
          >
            Explore All Calculators &rarr;
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
