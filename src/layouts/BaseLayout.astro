---
// src/layouts/BaseLayout.astro
import { ClientRouter } from "astro:transitions";
import { SITE } from "../config/site";
import "@/styles/style.css";
import BackToTop from "@components/BackToTop.astro";

interface Props {
    title?: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = SITE.description,
    lang = SITE.defaultLanguage,
} = Astro.props;

// Formats title nicely: e.g. "About | Santanu's Space", or falls back to "Santanu's Space" if title isn't provided
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta
            name="google-site-verification"
            content="J46AE7qtW861R5WPls8Ju_9DLlIJ-KW7lqcqjeIaTU4"
        />
        <meta charset="utf-8" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <!-- Author & Description from SITE config -->
        <meta name="author" content={SITE.author} />
        <meta name="description" content={description} />

        <title>{pageTitle}</title>

        <!-- ASTRO VIEW TRANSITIONS -->
        <ClientRouter />

        <!-- ⚡ ANTI-FLASH INLINE SCRIPT (Prevents white flash on dark mode reload) -->
        <script is:inline>
            (function () {
                const savedTheme = localStorage.getItem("theme");
                if (savedTheme) {
                    document.documentElement.setAttribute(
                        "data-theme",
                        savedTheme,
                    );
                } else if (
                    window.matchMedia("(prefers-color-scheme: dark)").matches
                ) {
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.setAttribute(
                        "data-theme",
                        "light",
                    );
                }
            })();
        </script>
    </head>
    <body>
        <!-- Everything from your pages will be injected here -->
        <slot />
    </body>
</html>

<!-- GLOBAL THEME VARIABLES -->
<style is:global>
    /* Default / Light Mode */
    :root {
        --bg-main: #f8fafd;
        --bg-card: #ffffff;
        --text-heading: #1f2937;
        --text-body: #374151;
        --text-muted: #6b7280;
        --border-color: #e2e8f0;
        --bg-highlight: #f0fdf4;
        --brand-primary: #0b3d91;
        --brand-accent: #15803d;
    }

    /* Dark Mode Overrides */
    [data-theme="dark"] {
        --bg-main: #0f172a;
        --bg-card: #1e293b;
        --text-heading: #f8fafc;
        --text-body: #e2e8f0;
        --text-muted: #94a3b8;
        --border-color: #334155;
        --bg-highlight: #064e3b;
        --brand-primary: #60a5fa;
        --brand-accent: #4ade80;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-body);
        transition:
            background-color 0.25s ease,
            color 0.25s ease;
    }
</style>
