---
// src/components/HealthCoverCalculator.astro
interface Props {
  lang?: "en" | "bn";
}

const { lang = "en" } = Astro.props;

// Master City List with Tier Mapping
const CITIES = [
  // Tier 1 Metros
  { nameEn: "Kolkata", nameBn: "কলকাতা", tier: "tier1" },
  { nameEn: "Delhi NCR", nameBn: "দিল্লি এনসিআর", tier: "tier1" },
  { nameEn: "Mumbai", nameBn: "মুম্বাই", tier: "tier1" },
  { nameEn: "Bengaluru", nameBn: "বেঙ্গালুরু", tier: "tier1" },
  { nameEn: "Chennai", nameBn: "চেন্নাই", tier: "tier1" },
  { nameEn: "Hyderabad", nameBn: "হায়দ্রাবাদ", tier: "tier1" },
  { nameEn: "Pune", nameBn: "পুণে", tier: "tier1" },
  { nameEn: "Ahmedabad", nameBn: "আমেদাবাদ", tier: "tier1" },

  // Tier 2 Major Cities
  { nameEn: "Siliguri", nameBn: "শিলিগুড়ি", tier: "tier2" },
  { nameEn: "Howrah", nameBn: "হাওড়া", tier: "tier2" },
  { nameEn: "Durgapur", nameBn: "দুর্গাপুর", tier: "tier2" },
  { nameEn: "Asansol", nameBn: "আসানসোল", tier: "tier2" },
  { nameEn: "Patna", nameBn: "পাটনা", tier: "tier2" },
  { nameEn: "Bhubaneswar", nameBn: "ভুবনেশ্বর", tier: "tier2" },
  { nameEn: "Ranchi", nameBn: "রাঁচি", tier: "tier2" },
  { nameEn: "Lucknow", nameBn: "লখনউ", tier: "tier2" },
  { nameEn: "Jaipur", nameBn: "জয়পুর", tier: "tier2" },
  { nameEn: "Guwahati", nameBn: "গুয়াহাটি", tier: "tier2" },
  { nameEn: "Chandigarh", nameBn: "চণ্ডীগড়", tier: "tier2" },
  { nameEn: "Kochi", nameBn: "কোচি", tier: "tier2" },
  { nameEn: "Indore", nameBn: "ইন্দোর", tier: "tier2" },
];

const translations = {
  en: {
    title: "Health Cover Estimator",
    subtitle:
      "Estimate the optimal health insurance cover for you and your family.",
    ageLabel: "Age of Eldest Family Member",
    adultsLabel: "Number of Adults",
    childrenLabel: "Number of Children",
    cityLabel: "City of Residence",
    cityPlaceholder: "Type or select your city...",
    cityHelp:
      "💡 Healthcare costs in Metro cities are 30–40% higher, requiring a higher base cover.",
    tier1Option: "Other Tier 1 / Metro City",
    tier2Option: "Other Tier 2 Major City",
    tier3Option: "Tier 3 / Other Towns & Rural Areas",
    preExistingLabel:
      "Any Pre-existing Diseases? (Diabetes, BP, Heart conditions, etc.)",
    yes: "Yes",
    no: "No",
    calcBtn: "Calculate Recommended Cover",
    resultHeading: "Recommended Health Insurance Cover",
    baseLabel: "Base Hospitalization Cover:",
    superTopUpLabel: "Suggested Super Top-up Cover:",
    breakdownTitle: "How This Was Calculated:",
    inflationNote:
      "Includes ~10–12% annual medical inflation buffer for hospital procedures.",
  },
  bn: {
    title: "হেলথ কভার এস্টিমেটর",
    subtitle:
      "আপনার এবং আপনার পরিবারের জন্য সঠিক স্বাস্থ্য বিমা কভারের পরিমাণ হিসাব করুন।",
    ageLabel: "পরিবারের জ্যেষ্ঠ সদস্যের বয়স",
    adultsLabel: "প্রাপ্তবয়স্ক সদস্য সংখ্যা",
    childrenLabel: "শিশু সংখ্যা (১৮ বছরের নিচে)",
    cityLabel: "আপনার বসবাসের শহর",
    cityPlaceholder: "আপনার শহর খুঁজুন বা টাইপ করুন...",
    cityHelp:
      "💡 মেট্রো শহরে চিকিৎসার খরচ ৩০-৪০% বেশি হওয়ায় স্বাস্থ্য কভার বেশি ধরা হয়।",
    tier1Option: "অন্যান্য মেট্রো / Tier 1 শহর",
    tier2Option: "অন্যান্য প্রধান Tier 2 শহর",
    tier3Option: "Tier 3 / অন্যান্য ছোট শহর ও গ্রামীণ এলাকা",
    preExistingLabel:
      "পরিবারে কারো পূর্বের গুরুতর রোগ আছে? (ডায়াবেটিস, প্রেসার, হৃদরোগ ইত্যাদি)",
    yes: "হ্যাঁ",
    no: "না",
    calcBtn: "প্রয়োজনীয় কভার হিসাব করুন",
    resultHeading: "সুপারিশকৃত স্বাস্থ্য বিমা কভার",
    baseLabel: "মূল বিমা কভার (Base Cover):",
    superTopUpLabel: "সুপারিশকৃত সুপার টপ-আপ কভার:",
    breakdownTitle: "হিসাবের মূল ভিত্তি:",
    inflationNote:
      "বার্ষিক ১০-১২% চিকিৎসা খরচ বৃদ্ধি (Medical Inflation) বিবেচনায় রাখা হয়েছে।",
  },
};

const t = translations[lang] || translations.en;
const isBn = lang === "bn";
---

<div class="health-calc-card">
  <div class="calc-header">
    <h2>{t.title}</h2>
    <p>{t.subtitle}</p>
  </div>

  <form id="healthCalcForm" onsubmit="return false;">
    <div class="form-grid">
      <!-- Eldest Age -->
      <div class="form-group">
        <label for="eldestAge">{t.ageLabel}</label>
        <input
          type="number"
          id="eldestAge"
          min="18"
          max="100"
          value="35"
          required
        />
      </div>

      <!-- Adults Count -->
      <div class="form-group">
        <label for="adultCount">{t.adultsLabel}</label>
        <select id="adultCount">
          <option value="1">1 Adult (Individual)</option>
          <option value="2" selected>2 Adults (Self + Spouse)</option>
          <option value="3">3 Adults (Incl. Parents/In-laws)</option>
          <option value="4">4 Adults</option>
        </select>
      </div>

      <!-- Children Count -->
      <div class="form-group">
        <label for="childCount">{t.childrenLabel}</label>
        <select id="childCount">
          <option value="0">0</option>
          <option value="1">1 Child</option>
          <option value="2" selected>2 Children</option>
          <option value="3">3+ Children</option>
        </select>
      </div>

      <!-- City Selection with Autocomplete Datalist -->
      <div class="form-group full-width">
        <label for="citySearchInput">{t.cityLabel}</label>
        <input
          type="text"
          id="citySearchInput"
          list="cityListOptions"
          placeholder={t.cityPlaceholder}
          autocomplete="off"
        />
        <datalist id="cityListOptions">
          {
            CITIES.map((city) => (
              <option
                value={isBn ? city.nameBn : city.nameEn}
                data-tier={city.tier}
              />
            ))
          }
          <option value={t.tier1Option} data-tier="tier1"></option>
          <option value={t.tier2Option} data-tier="tier2"></option>
          <option value={t.tier3Option} data-tier="tier3"></option>
        </datalist>
        <!-- Hidden field that stores the calculated tier -->
        <input type="hidden" id="cityTier" value="tier2" />
        <small class="help-text">{t.cityHelp}</small>
      </div>

      <!-- Pre-existing Conditions -->
      <div class="form-group full-width">
        <label>{t.preExistingLabel}</label>
        <div class="radio-group">
          <label class="radio-label">
            <input type="radio" name="ped" value="no" checked />
            {t.no}
          </label>
          <label class="radio-label">
            <input type="radio" name="ped" value="yes" />
            {t.yes}
          </label>
        </div>
      </div>
    </div>

    <button type="button" id="calculateHealthBtn" class="calc-btn"
      >{t.calcBtn}</button
    >
  </form>

  <!-- Calculation Results -->
  <div id="healthResult" class="results-card" style="display: none;">
    <h3>{t.resultHeading}</h3>

    <div class="result-box">
      <div class="result-item primary">
        <span>{t.baseLabel}</span>
        <strong id="baseCoverDisplay">₹ 0</strong>
      </div>
      <div class="result-item secondary">
        <span>{t.superTopUpLabel}</span>
        <strong id="topUpCoverDisplay">₹ 0</strong>
      </div>
    </div>

    <div class="breakdown-box">
      <h4>{t.breakdownTitle}</h4>
      <ul id="breakdownList"></ul>
      <p class="inflation-note">ℹ️ {t.inflationNote}</p>
    </div>
  </div>
</div>

<style>
  .health-calc-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid #e5e7eb;
    max-width: 750px;
    margin: 0 auto;
  }

  .calc-header h2 {
    color: #0b3d91;
    margin-bottom: 0.5rem;
    font-size: 1.6rem;
  }

  .calc-header p {
    color: #4b5563;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group.full-width {
    grid-column: span 2;
  }

  label {
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: #1f2937;
    font-size: 0.9rem;
  }

  input[type="number"],
  input[type="text"],
  select {
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.95rem;
    background-color: #fff;
    color: #111827;
  }

  input[type="number"]:focus,
  input[type="text"]:focus,
  select:focus {
    outline: none;
    border-color: #0b3d91;
    box-shadow: 0 0 0 3px rgba(11, 61, 145, 0.1);
  }

  .help-text {
    margin-top: 0.35rem;
    color: #6b7280;
    font-size: 0.82rem;
  }

  .radio-group {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.25rem;
  }

  .radio-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: normal;
    cursor: pointer;
  }

  .calc-btn {
    margin-top: 1.5rem;
    width: 100%;
    padding: 0.9rem;
    background-color: #0b3d91;
    color: #ffffff;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .calc-btn:hover {
    background-color: #082d6c;
  }

  .results-card {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 2px dashed #e5e7eb;
  }

  .results-card h3 {
    color: #0b3d91;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .result-box {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .result-item {
    padding: 1rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .result-item.primary {
    background-color: #eef2ff;
    border: 1px solid #c7d2fe;
  }

  .result-item.secondary {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
  }

  .result-item span {
    font-size: 0.85rem;
    color: #4b5563;
  }

  .result-item strong {
    font-size: 1.4rem;
    color: #0b3d91;
  }

  .result-item.secondary strong {
    color: #166534;
  }

  .breakdown-box {
    background-color: #f9fafb;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border: 1px solid #f3f4f6;
  }

  .breakdown-box h4 {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    color: #374151;
  }

  .breakdown-box ul {
    padding-left: 1.2rem;
    margin-bottom: 0.75rem;
    font-size: 0.88rem;
    color: #4b5563;
  }

  .breakdown-box li {
    margin-bottom: 0.3rem;
  }

  .inflation-note {
    font-size: 0.8rem;
    color: #6b7280;
    margin: 0;
  }

  @media (max-width: 600px) {
    .form-grid,
    .result-box {
      grid-template-columns: 1fr;
    }
    .form-group.full-width {
      grid-column: span 1;
    }
  }
</style>

<script>
  function syncCityTier() {
    const searchInput = document.getElementById(
      "citySearchInput",
    ) as HTMLInputElement | null;
    const datalist = document.getElementById(
      "cityListOptions",
    ) as HTMLDataListElement | null;
    const tierHiddenInput = document.getElementById(
      "cityTier",
    ) as HTMLInputElement | null;

    if (!searchInput || !datalist || !tierHiddenInput) return;

    const query = searchInput.value.trim().toLowerCase();
    if (!query) {
      tierHiddenInput.value = "tier2";
      return;
    }

    const options = Array.from(datalist.options);
    const matchedOption = options.find(
      (opt) => opt.value.toLowerCase() === query,
    );

    if (matchedOption) {
      tierHiddenInput.value =
        matchedOption.getAttribute("data-tier") || "tier2";
    } else {
      // Default to Tier 2 if user enters an unlisted custom city name
      tierHiddenInput.value = "tier2";
    }
  }

  function calculateHealthCover() {
    syncCityTier();

    const eldestInput = document.getElementById(
      "eldestAge",
    ) as HTMLInputElement | null;
    const adultSelect = document.getElementById(
      "adultCount",
    ) as HTMLSelectElement | null;
    const childSelect = document.getElementById(
      "childCount",
    ) as HTMLSelectElement | null;
    const cityTierInput = document.getElementById(
      "cityTier",
    ) as HTMLInputElement | null;
    const pedRadio = document.querySelector(
      'input[name="ped"]:checked',
    ) as HTMLInputElement | null;

    if (!eldestInput || !adultSelect || !childSelect || !cityTierInput) return;

    const age = parseInt(eldestInput.value) || 35;
    const adults = parseInt(adultSelect.value) || 2;
    const children = parseInt(childSelect.value) || 0;
    const cityTier = cityTierInput.value;
    const hasPED = pedRadio?.value === "yes";

    let baseCover = 500000; // Base ₹5 Lakhs minimum
    const notes: string[] = [];

    // City Tier Adjustment
    if (cityTier === "tier1") {
      baseCover += 500000;
      notes.push("Added ₹5L base cover for Tier 1 Metro healthcare costs.");
    } else if (cityTier === "tier2") {
      baseCover += 200000;
      notes.push("Added ₹2L base cover for Tier 2 city hospital expenses.");
    }

    // Age Factor
    if (age >= 60) {
      baseCover += 500000;
      notes.push("Added ₹5L for senior citizen hospital stay risks.");
    } else if (age >= 45) {
      baseCover += 300000;
      notes.push("Added ₹3L adjustment for age 45+ health contingencies.");
    }

    // Family Size Adjustment
    if (adults > 2 || children > 2) {
      baseCover += 300000;
      notes.push("Adjusted for larger family size.");
    }

    // Pre-existing Disease Adjustment
    if (hasPED) {
      baseCover += 200000;
      notes.push("Added buffer for pre-existing illness treatment costs.");
    }

    // Calculate Super Top-up
    let topUpCover = baseCover * 2;
    if (baseCover <= 700000) {
      topUpCover = 1500000;
    }

    // Render results
    const baseDisplay = document.getElementById("baseCoverDisplay");
    const topUpDisplay = document.getElementById("topUpCoverDisplay");
    const breakdownList = document.getElementById("breakdownList");
    const resultCard = document.getElementById("healthResult");

    if (baseDisplay && topUpDisplay && breakdownList && resultCard) {
      baseDisplay.textContent = `₹ ${(baseCover / 100000).toFixed(1)} Lakhs`;
      topUpDisplay.textContent = `₹ ${(topUpCover / 100000).toFixed(1)} Lakhs`;

      breakdownList.innerHTML = notes.map((n) => `<li>${n}</li>`).join("");
      resultCard.style.display = "block";
    }
  }

  function initCalculator() {
    const calcBtn = document.getElementById("calculateHealthBtn");
    const searchInput = document.getElementById("citySearchInput");

    if (calcBtn) {
      calcBtn.removeEventListener("click", calculateHealthCover);
      calcBtn.addEventListener("click", calculateHealthCover);
    }

    if (searchInput) {
      searchInput.removeEventListener("input", syncCityTier);
      searchInput.addEventListener("input", syncCityTier);
    }
  }

  // Initialize immediately
  initCalculator();

  // Support Astro View Transitions / Client Navigation
  document.addEventListener("astro:page-load", initCalculator);
</script>
