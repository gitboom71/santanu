---
// ============================================================================
// Header Component for Astro Project
// Purpose: Main site navigation bar with active highlights & ThemeToggle
// Uses a clean, flat navigation structure (No submenus/dropdowns)
// ============================================================================

import { navTranslations } from "@/utils/i18n";
import ThemeToggle from "@/components/ThemeToggle.astro";
import "@/styles/header.css";

interface Props {
  lang?: "en" | "bn";
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;

// Auto-detect language from URL route if prop is not explicitly passed
const isBengali = lang ? lang === "bn" : currentPath.startsWith("/bn");
const currentLang = isBengali ? "bn" : "en";

// Load translation dictionary
const t = navTranslations[currentLang] || navTranslations.en;

// Clean routing paths
const cleanPath = currentPath.replace(/\/$/, "") || "/";

// Calculate opposite language toggle URL
let toggleUrl = "/";
if (isBengali) {
  const enPath = currentPath.replace(/^\/bn/, "");
  toggleUrl = enPath === "" ? "/" : enPath;
} else {
  toggleUrl = `/bn${currentPath === "/" ? "" : currentPath}`;
}

function isActive(targetPath: string): boolean {
  const cleanTarget = targetPath.replace(/\/$/, "") || "/";
  if (cleanTarget === "/" || cleanTarget === "/bn") {
    return cleanPath === cleanTarget;
  }
  return cleanPath.startsWith(cleanTarget);
}
---

<!-- SECTION 1: HEADER CONTAINER WITH TRANSLATION SHIELD -->
<header class="site-header notranslate" translate="no">
  <div class="nav-container">
    <!-- BRAND / LOGO AREA -->
    <a href={isBengali ? "/bn" : "/"} class="brand">
      <span class="brand-title">Santanu's Space</span>
      <span class="brand-subtitle">Technology • Insurance • Learning</span>
    </a>

    <!-- HAMBURGER TRIGGER BUTTON -->
    <button
      id="menuToggle"
      class="hamburger-btn"
      aria-label="Toggle Navigation"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- NAVIGATION MENU (FLAT STRUCTURE - NO DROPDOWNS) -->
    <nav id="navMenu" class="nav-menu" aria-label="Main Navigation">
      <ul class="nav-list">
        <!-- LINK: Home -->
        <li>
          <a
            href={isBengali ? "/bn" : "/"}
            class={`nav-link ${isActive(isBengali ? "/bn" : "/") ? "active" : ""}`}
          >
            <span>{t.home}</span>
          </a>
        </li>

        <!-- LINK: About -->
        <li>
          <a
            href={isBengali ? "/bn/about" : "/about"}
            class={`nav-link ${isActive(isBengali ? "/bn/about" : "/about") ? "active" : ""}`}
          >
            <span>{t.about}</span>
          </a>
        </li>

        <!-- LINK: Projects -->
        <li>
          <a
            href={isBengali ? "/bn/projects" : "/projects"}
            class={`nav-link ${isActive(isBengali ? "/bn/projects" : "/projects") ? "active" : ""}`}
          >
            <span>{t.projects}</span>
          </a>
        </li>

        <!-- LINK: Insurance (Acts as the Hub Page) -->
        <li>
          <a
            href={isBengali ? "/bn/insurance" : "/insurance"}
            class={`nav-link ${isActive(isBengali ? "/bn/insurance" : "/insurance") ? "active" : ""}`}
          >
            <span>{t.insurance}</span>
          </a>
        </li>

        <!-- LINK: Learning -->
        <li>
          <a
            href={isBengali ? "/bn/learning" : "/learning"}
            class={`nav-link ${isActive(isBengali ? "/bn/learning" : "/learning") ? "active" : ""}`}
          >
            <span>{t.learning}</span>
          </a>
        </li>

        <!-- LINK: Blog -->
        <li>
          <a
            href={isBengali ? "/bn/blog" : "/blog"}
            class={`nav-link ${isActive(isBengali ? "/bn/blog" : "/blog") ? "active" : ""}`}
          >
            <span>{t.blog}</span>
          </a>
        </li>

        <!-- LINK: Contact -->
        <li>
          <a
            href={isBengali ? "/bn/contact" : "/contact"}
            class={`nav-link ${isActive(isBengali ? "/bn/contact" : "/contact") ? "active" : ""}`}
          >
            <span>{t.contact}</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- RIGHT ACTION BUTTONS -->
    <div class="header-actions">
      <!-- Language Switcher -->
      <a
        href={toggleUrl}
        class="action-btn lang-btn"
        lang={isBengali ? "en" : "bn"}
      >
        <span>{isBengali ? "English" : "বাংলা"}</span>
      </a>

      <!-- Modular Theme Toggle Component -->
      <ThemeToggle />
    </div>
  </div>
</header>

<!-- SECTION 2: TRANSITIONS LIFE CYCLE SCRIPTS -->
<script is:inline>
  function setupMobileMenu() {
    const toggle = document.getElementById("menuToggle");
    const menu = document.getElementById("navMenu");

    if (!toggle || !menu) return;

    // Clone button to strip duplicate event listeners on Astro view transitions
    const newToggle = toggle.cloneNode(true);
    if (toggle.parentNode) {
      toggle.parentNode.replaceChild(newToggle, toggle);
    }
    const activeToggle = document.getElementById("menuToggle");

    if (!activeToggle) return;

    // Toggle mobile menu drawer open/close
    activeToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isActive = menu.classList.toggle("is-active");
      activeToggle.classList.toggle("is-active");
      activeToggle.setAttribute("aria-expanded", isActive.toString());
    });

    // Close menu when clicking any nav link
    menu.addEventListener("click", (e) => {
      const targetLink = e.target.closest("a");
      if (!targetLink) return;

      if (document.activeElement instanceof HTMLElement) {
        document.activeElement.blur();
      }

      menu.classList.remove("is-active");
      activeToggle.classList.remove("is-active");
      activeToggle.setAttribute("aria-expanded", "false");
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (
        menu.classList.contains("is-active") &&
        !menu.contains(target) &&
        !activeToggle.contains(target)
      ) {
        menu.classList.remove("is-active");
        activeToggle.classList.remove("is-active");
        activeToggle.setAttribute("aria-expanded", "false");
      }
    });
  }

  document.addEventListener("astro:before-swap", () => {
    if (document.activeElement instanceof HTMLElement) {
      document.activeElement.blur();
    }
  });

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
