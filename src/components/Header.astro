---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isBn = Astro.props.lang === 'bn' || pathname.startsWith('/bn/') || pathname === '/bn';
const currentLang = isBn ? 'bn' : 'en';

let togglePath = '/';
if (isBn) {
  togglePath = pathname.replace(/^\/bn(\/|$)/, '/') || '/';
} else {
  togglePath = pathname === '/' ? '/bn' : `/bn${pathname}`;
}
const cleanTogglePath = togglePath.replace(/\/\//g, '/');

const getNavPath = (path: string) => {
  const target = currentLang === 'bn' ? `/bn${path}` : path;
  return target.replace(/\/\//g, '/');
};

const isActive = (path: string) => {
  const currentClean = pathname.replace(/\/$/, '') || '/';
  const targetClean = getNavPath(path).replace(/\/$/, '') || '/';
  return currentClean === targetClean;
};
---

<header class="site-header">
  <div class="header-container">
    
    <button 
      id="mobile-menu-btn" 
      class="hamburger-btn" 
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <div class="brand-group">
      <a href={getNavPath('/')} class="brand-logo">
        {currentLang === 'bn' ? 'শান্তনু মুখার্জ্জী' : "Santanu's Space"}
      </a>
      <span class="brand-tagline">
        {currentLang === 'bn' ? 'প্রযুক্তি • বীমা • শিক্ষা' : 'Technology • Insurance • Learning'}
      </span>
    </div>

    <div class="header-controls">
      <a href={cleanTogglePath} class="lang-toggle" aria-label="Switch Language">
        {currentLang === 'bn' ? 'ENG' : 'বাংলা'}
      </a>
      <ThemeToggle />
    </div>

  </div>

  <nav id="main-nav" class="nav-menu" aria-label="Main Navigation">
    <ul class="nav-links">
      <li><a href={getNavPath('/')} class={isActive('/') ? 'active' : ''}>{currentLang === 'bn' ? 'হোম' : 'Home'}</a></li>
      <li><a href={getNavPath('/about')} class={isActive('/about') ? 'active' : ''}>{currentLang === 'bn' ? 'আমার সম্পর্কে' : 'About'}</a></li>
      <li><a href={getNavPath('/projects')} class={isActive('/projects') ? 'active' : ''}>{currentLang === 'bn' ? 'প্রকল্পসমূহ' : 'Projects'}</a></li>
      
      <!-- Insurance Dropdown Sub-menu -->
      <li class="nav-dropdown">
        <a href={getNavPath('/insurance')} class={`dropdown-toggle ${isActive('/insurance') ? 'active' : ''}`}>
          {currentLang === 'bn' ? 'বীমা' : 'Insurance'} <span class="arrow">▾</span>
        </a>
        <ul class="dropdown-menu">
          <li><a href={getNavPath('/insurance/life')}>{currentLang === 'bn' ? 'জীবন বীমা' : 'Life Insurance'}</a></li>
          <li><a href={getNavPath('/insurance/health')}>{currentLang === 'bn' ? 'স্বাস্থ্য বীমা' : 'Health Insurance'}</a></li>
        </ul>
      </li>

      <li><a href={getNavPath('/learning')} class={isActive('/learning') ? 'active' : ''}>{currentLang === 'bn' ? 'শিক্ষা' : 'Learning'}</a></li>
      <li><a href={getNavPath('/blog')} class={isActive('/blog') ? 'active' : ''}>{currentLang === 'bn' ? 'ব্লগ' : 'Blog'}</a></li>
      <li><a href={getNavPath('/contact')} class={isActive('/contact') ? 'active' : ''}>{currentLang === 'bn' ? 'যোগাযোগ' : 'Contact'}</a></li>
    </ul>
  </nav>
</header>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navMenu = document.getElementById('main-nav');

    if (!menuBtn || !navMenu) return;

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      navMenu.classList.toggle('is-open');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!menuBtn.contains(target) && !navMenu.contains(target)) {
        navMenu.classList.remove('is-open');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>