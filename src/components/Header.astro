---
// ============================================================================
// Header Component for Astro Project
// Purpose: Main site navigation bar with active highlights & embedded ThemeToggle
// Includes a regression-safe responsive mobile hamburger menu
// ============================================================================

import { navTranslations } from "@/utils/i18n";
import ThemeToggle from "./ThemeToggle.astro";
// Import your new decoupled header styles here
// (Adjust path prefix depending on your project directory layout)
import "@/styles/header.css";
interface Props {
  lang?: "en" | "bn";
}

const { lang = "en" } = Astro.props;
const t = navTranslations[lang] || navTranslations.en;

// ----------------------------------------------------------------------------
// ROUTING & ACTIVE LINK DETECTION
// ----------------------------------------------------------------------------
const currentPath = Astro.url.pathname;
const isBengali = currentPath.startsWith("/bn");
const cleanPath = currentPath.replace(/\/$/, "") || "/";

const toggleUrl = isBengali
  ? currentPath.replace(/^\/bn/, "") || "/"
  : `/bn${currentPath === "/" ? "" : currentPath}`;

function isActive(targetPath: string): boolean {
  const cleanTarget = targetPath.replace(/\/$/, "") || "/";
  if (cleanTarget === "/" || cleanTarget === "/bn") {
    return cleanPath === cleanTarget;
  }
  return cleanPath.startsWith(cleanTarget);
}
---

<!-- SECTION 1: HEADER CONTAINER --><!-- SECTION 1: HEADER CONTAINER WITH INLINE DISMISS TRIGGERS -->
<header class="site-header">
  <div class="nav-container">
    <!-- BRAND / LOGO AREA -->
    <a href={isBengali ? "/bn" : "/"} class="brand">
      <span class="brand-title">Santanu's Space</span>
      <span class="brand-subtitle">Technology • Insurance • Learning</span>
    </a>

    <!-- HAMBURGER TRIGGER BUTTON -->
    <button
      id="menuToggle"
      class="hamburger-btn"
      aria-label="Toggle Navigation"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <!-- NAVIGATION MENU (CLEAN FLAT STYLE) -->
    <nav id="navMenu" class="nav-menu">
      <ul class="nav-list">
        <!-- LINK: Home -->
        <li>
          <a
            href={isBengali ? "/bn" : "/"}
            class={`nav-link ${isActive(isBengali ? "/bn" : "/") ? "active" : ""}`}
          >
            {t.home}
          </a>
        </li>

        <!-- LINK: About -->
        <li>
          <a
            href={isBengali ? "/bn/about" : "/about"}
            class={`nav-link ${isActive(isBengali ? "/bn/about" : "/about") ? "active" : ""}`}
          >
            {t.about}
          </a>
        </li>

        <!-- LINK: Projects -->
        <li>
          <a
            href={isBengali ? "/bn/projects" : "/projects"}
            class={`nav-link ${isActive(isBengali ? "/bn/projects" : "/projects") ? "active" : ""}`}
          >
            {t.projects}
          </a>
        </li>

        <!-- DROPDOWN: Insurance -->
        <li class="dropdown-parent">
          <a
            href={isBengali ? "/bn/insurance" : "/insurance"}
            class={`nav-link dropdown-toggle ${isActive("/insurance") || isActive("/life-insurance") || isActive("/health-insurance") ? "active" : ""}`}
          >
            {t.insurance}
            <span class="arrow">▼</span>
          </a>
          <ul class="dropdown-menu">
            <li>
              <a href={isBengali ? "/bn/life-insurance" : "/life-insurance"}>
                {isBengali ? "লাইফ ইনসিওরেন্স" : "Life Insurance"}
              </a>
            </li>
            <li>
              <a
                href={isBengali ? "/bn/health-insurance" : "/health-insurance"}
              >
                {isBengali ? "হেলথ ইনসিওরেন্স" : "Health Insurance"}
              </a>
            </li>
          </ul>
        </li>

        <!-- LINK: Learning -->
        <li>
          <a
            href={isBengali ? "/bn/learning" : "/learning"}
            class={`nav-link ${isActive(isBengali ? "/bn/learning" : "/learning") ? "active" : ""}`}
          >
            {t.learning}
          </a>
        </li>

        <!-- LINK: Blog -->
        <li>
          <a
            href={isBengali ? "/bn/blog" : "/blog"}
            class={`nav-link ${isActive(isBengali ? "/bn/blog" : "/blog") ? "active" : ""}`}
          >
            {t.blog}
          </a>
        </li>

        <!-- LINK: Contact -->
        <li>
          <a
            href={isBengali ? "/bn/contact" : "/contact"}
            class={`nav-link ${isActive(isBengali ? "/bn/contact" : "/contact") ? "active" : ""}`}
          >
            {t.contact}
          </a>
        </li>
      </ul>
    </nav>

    <!-- RIGHT ACTION BUTTONS -->
    <div class="header-actions">
      <!-- Language Switcher -->
      <a href={toggleUrl} class="action-btn lang-btn">
        {t.langToggle}
      </a>

      <!-- Modular Theme Toggle Component -->
      <ThemeToggle />
    </div>
  </div>
</header>

<!-- SECTION 2: STYLESHEET (SCOPED STYLES) -- style section was her e but moved to header.css for decoupling -->

<!-- SECTION 3: TRANSITIONS LIFE CYCLE SCRIPTS -->
<script is:inline>
  function setupMobileMenu() {
    const toggle = document.getElementById("menuToggle");
    const menu = document.getElementById("navMenu");

    if (!toggle || !menu) return;

    const newToggle = toggle.cloneNode(true);
    toggle.parentNode.replaceChild(newToggle, toggle);
    const activeToggle = document.getElementById("menuToggle");

    activeToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isActive = menu.classList.toggle("is-active");
      activeToggle.classList.toggle("is-active");
      activeToggle.setAttribute("aria-expanded", isActive.toString());
    });

    menu.addEventListener("click", (e) => {
      const targetLink = e.target.closest("a");
      if (!targetLink) return;

      const isDropdownToggle = targetLink.classList.contains("dropdown-toggle");

      if (isDropdownToggle) {
        if (window.innerWidth <= 768) {
          e.preventDefault();
          e.stopPropagation();

          const parentLi = targetLink.closest(".dropdown-parent");
          if (parentLi) {
            parentLi.classList.toggle("dropdown-open");
          }
        }
      } else {
        if (document.activeElement instanceof HTMLElement) {
          document.activeElement.blur();
        }

        document.querySelectorAll(".dropdown-parent").forEach((item) => {
          item.classList.remove("dropdown-open");
        });

        menu.classList.remove("is-active");
        activeToggle.classList.remove("is-active");
        activeToggle.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (
        menu.classList.contains("is-active") &&
        !menu.contains(target) &&
        !activeToggle.contains(target)
      ) {
        menu.classList.remove("is-active");
        activeToggle.classList.remove("is-active");
        activeToggle.setAttribute("aria-expanded", "false");

        document.querySelectorAll(".dropdown-parent").forEach((item) => {
          item.classList.remove("dropdown-open");
        });
      }
    });
  }

  document.addEventListener("astro:before-swap", () => {
    if (document.activeElement instanceof HTMLElement) {
      document.activeElement.blur();
    }
  });

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
  document.addEventListener("astro:after-swap", setupMobileMenu);
</script>
