---
// src/components/Header.astro
import ThemeToggle from './ThemeToggle.astro';
import { getLangFromUrl, useTranslations } from '../utils/i18n';

const { lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;

// Dynamic link generator preserving language route
const getNavPath = (path: string) => (lang === 'bn' ? `/bn${path}` : path);
---

<header class="site-header">
  <div class="header-container">
    <a href={getNavPath('/')} class="brand-logo">
      {lang === 'bn' ? 'শান্তনু মুখার্জ্জী' : "Santanu's Space"}
    </a>

    <div class="nav-controls">
      <a 
        href={lang === 'bn' ? currentPath.replace('/bn', '') || '/' : `/bn${currentPath}`} 
        class="lang-toggle"
        aria-label="Switch Language"
      >
        {lang === 'bn' ? 'EN' : 'BN'}
      </a>

      <ThemeToggle />

      <button 
        id="mobile-menu-btn" 
        class="hamburger-btn" 
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>

    <nav id="main-nav" class="nav-menu" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href={getNavPath('/')}>Home</a></li>
        <li><a href={getNavPath('/about')}>About</a></li>
        <li><a href={getNavPath('/insurance')}>Insurance</a></li>
        <li><a href={getNavPath('/contact')}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Re-bind click listener on initial load and view transitions
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const navMenu = document.getElementById('main-nav');

    if (!menuBtn || !navMenu) return;

    // Toggle menu logic
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      navMenu.classList.toggle('is-open');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!menuBtn.contains(target) && !navMenu.contains(target)) {
        navMenu.classList.remove('is-open');
        menuBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Initialize on full page load & Astro ClientRouter page swaps
  document.addEventListener('astro:page-load', initMobileMenu);
</script>